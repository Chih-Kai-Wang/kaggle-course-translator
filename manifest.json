{
  "manifest_version": 3,
  "name": "原版美感 AI 網頁翻譯助手",
  "version": "2.0.0",
  "description": "適用於所有網站的原版排版 AI 翻譯擴充功能（內建 Kaggle / Jupyter Notebook 深度強化）：預設靜默點擊即譯、SSE 串流逐段上屏、本地版面決策樹與母語級字體配對。",
  "minimum_chrome_version": "119",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "原版美感 AI 網頁翻譯助手",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "toggle-translate-page": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "立即翻譯 / 切換目前頁面"
    }
  }
}
